# === Keil 工程必要文件 (不可忽略) ===
# .uvprojx (工程文件) 和 .uvoptx (配置选项) 建议保留

# === 过滤 Keil 编译生成的临时文件夹 ===
Library/
Listings/
Objects/
DebugConfig/
Start/
Debug/
Release/
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# === 过滤特定的临时文件后缀 ===
*.bak
*.dep
*.txt
*.htm
*.lnp
*.sct
*.map
*.lst
*.o
*.d
*.crf
*.axf
*.i
*.iex
*.build_log.htm
*.scvd
*.s

# === 过滤用户本地配置 (防止不同电脑路径冲突) ===
*.uvgui.*
*.uvguix.*
.vs/
.settings/
.15981

# === 过滤 VS Code 和插件生成的临时日志 ===
.vscode/
*.log
*.lock

# === 过滤其他开发环境残留 ===
*.exe
*.sln
*.vcxproj
*.filters
*.user
*.suo
*.db
*.ipch
*.json
*.swf
*.air
*.ipa
*.apk

# === 排除 Git 自身文件 ===
.gitignore